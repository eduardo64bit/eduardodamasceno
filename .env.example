# Porta HTTP no host (Docker Compose)
EDUARDODAMASCENO_HTTP_PORT=9090

# SQLite (local ou dentro do container)
# SITE_DB_PATH=./data/site.db

# Editor — área /editor (CV, cases, status)
EDITOR_PASSWORD=sua-senha-aqui
EDITOR_SECRET=um-segredo-aleatorio-longo

# Portfolio Auth — leitura de /portfolio, /case e /cv
PORTFOLIO_PASSWORD=senha-para-leitores
PORTFOLIO_SECRET=outro-segredo-aleatorio-longo
# Seção Projetos na home pública (default: desligada)
# PORTFOLIO_SHOW_HOME_PROJECTS=true

# Chat → Telegram (BotFather + @userinfobot para obter TELEGRAM_CHAT_ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opcional — header X-Telegram-Bot-Api-Secret-Token no webhook
TELEGRAM_WEBHOOK_SECRET=

# URLs públicas
SITE_PUBLIC_ORIGIN=https://eduardodamasceno.com.br

# WordPress (import de cases — script futuro; não commitar valores reais)
# Site protegido por senha (wordpress.com):
WP_SITE_URL=https://eduardo64bit.wordpress.com
# Use aspas se a senha contiver # ou espaços:
WP_SITE_PASSWORD="sua-senha-do-site"
# Senha dos posts individuais (se diferente da senha do /portfolio/):
# WP_POST_PASSWORD="sua-senha-dos-cases"
